---
import Icon from "@/components/Icon.astro";
import type { SiteProfile } from "@/types";

interface Props {
  profile: SiteProfile;
}

const { profile } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__inner">
      <div class="site-footer__lede">
        <h2>Get in touch</h2>
        <p>
          I am always glad to hear from people working on clinical AI, longitudinal health data, or
          evaluation. Collaborations and student questions welcome.
        </p>
        <a class="site-footer__email" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>

      <div class="social" aria-label="Profiles">
        {
          profile.socialLinks.map((link) => (
            <a
              class="social__link"
              href={link.href}
              rel={link.href.startsWith("mailto:") ? undefined : "me noreferrer"}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
            >
              <Icon name={link.icon} />
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="site-footer__meta">
      <span>&copy; {year} {profile.name}</span>
      <span>Built with Astro. Hosted on GitHub Pages.</span>
    </div>
  </div>
</footer>
