---
import AuthorList from "@/components/AuthorList.astro";
import type { Publication } from "@/types";

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;
const primary = publication.links[0];
---

<article class="pub-card">
  <p class="pub-card__meta">
    <span class="pub-card__venue">{publication.venue}</span>
    <span class="pub-card__dot" aria-hidden="true">·</span>
    <span>{publication.year}</span>
    {publication.note && <span class="badge">{publication.note}</span>}
  </p>

  <h3 class="pub-card__title">
    {
      primary ? (
        <a href={primary.href} target="_blank" rel="noreferrer">
          {publication.title}
        </a>
      ) : (
        publication.title
      )
    }
  </h3>

  <AuthorList authors={publication.authors} />

  {publication.summary && <p class="pub-card__summary">{publication.summary}</p>}

  {
    publication.tags && publication.tags.length > 0 && (
      <div class="tag-row">
        {publication.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }
</article>

<style>
  .pub-card__title a {
    transition: color 0.15s ease;
  }

  .pub-card__title a:hover {
    color: var(--accent);
  }
</style>
