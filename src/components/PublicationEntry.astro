---
import AuthorList from "@/components/AuthorList.astro";
import Icon from "@/components/Icon.astro";
import type { Publication } from "@/types";

interface Props {
  publication: Publication;
  showSummary?: boolean;
}

const { publication, showSummary = true } = Astro.props;
const primary = publication.links[0];
---

<li class="pub">
  <div class="pub__year">{publication.year}</div>

  <div class="pub__body">
    <h3 class="pub__title">
      {
        primary ? (
          <a href={primary.href} target="_blank" rel="noreferrer">
            {publication.title}
          </a>
        ) : (
          publication.title
        )
      }
    </h3>

    <AuthorList authors={publication.authors} />

    <p class="pub__venue">
      <em>{publication.venue}</em>
      {publication.venueDetail && <span class="pub__venue-detail">{publication.venueDetail}</span>}
      {publication.note && <span class="badge">{publication.note}</span>}
    </p>

    {showSummary && publication.summary && <p class="pub__summary">{publication.summary}</p>}

    {
      publication.links.length > 0 && (
        <div class="pub__links">
          {publication.links.map((link) => (
            <a class="pub__link" href={link.href} target="_blank" rel="noreferrer">
              {link.label}
              <Icon name="external" />
            </a>
          ))}
        </div>
      )
    }
  </div>
</li>

<style>
  .pub__link :global(svg) {
    width: 11px;
    height: 11px;
    opacity: 0.55;
  }
</style>
