---
import type { FocusArea } from "@/types";

interface Props {
  focusAreas: FocusArea[];
}

const { focusAreas } = Astro.props;
---

<div class="focus-grid">
  {
    focusAreas.map((area, index) => (
      <article class="focus-card">
        <p class="focus-card__index">{String(index + 1).padStart(2, "0")}</p>
        <h3 class="focus-card__title">{area.title}</h3>
        <p class="focus-card__body">{area.description}</p>
        <div class="tag-row">
          {area.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </article>
    ))
  }
</div>
