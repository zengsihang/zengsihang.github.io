---
import { AUTHOR_SELF } from "@/data/site";

interface Props {
  authors: string[];
}

const { authors } = Astro.props;

const hasEtAl = authors.at(-1) === "et al.";
const named = hasEtAl ? authors.slice(0, -1) : authors;
---

<p class="pub__authors">
  {
    named.map((author, index) => (
      <>
        {author === AUTHOR_SELF ? <span class="self">{author}</span> : author}
        {index < named.length - 1 ? ", " : ""}
      </>
    ))
  }{hasEtAl ? ", et al." : ""}
</p>
