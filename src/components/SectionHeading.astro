---
interface Props {
  title: string;
  intro?: string;
  id?: string;
}

const { title, intro, id } = Astro.props;
---

<div class="section-head">
  <div class="section-head__row">
    <h2 class="section-head__title" id={id}>{title}</h2>
    <slot />
  </div>
  {intro && <p class="section-head__intro">{intro}</p>}
</div>
