---
import Icon from "@/components/Icon.astro";
import type { SiteProfile } from "@/types";

interface Props {
  profile: SiteProfile;
}

const { profile } = Astro.props;
---

<section class="hero">
  <div class="shell hero__grid">
    <div class="reveal">
      <h1 class="hero__name">{profile.name}</h1>

      <div class="hero__role">
        <span class="hero__role-title">{profile.role}</span>
        <span class="hero__role-org">
          {
            profile.affiliationHref ? (
              <a href={profile.affiliationHref} target="_blank" rel="noreferrer">
                {profile.affiliation}
              </a>
            ) : (
              profile.affiliation
            )
          }
          {
            profile.group && (
              <>
                {" · "}
                {profile.groupHref ? (
                  <a href={profile.groupHref} target="_blank" rel="noreferrer">
                    {profile.group}
                  </a>
                ) : (
                  profile.group
                )}
              </>
            )
          }
        </span>
      </div>

      <p class="hero__tagline">{profile.tagline}</p>

      <div class="hero__meta">
        <span><Icon name="pin" /> {profile.location}</span>
      </div>

      <div class="social" style="margin-top: 1.5rem;" aria-label="Profiles">
        {
          profile.socialLinks.map((link) => (
            <a
              class="social__link"
              href={link.href}
              rel={link.href.startsWith("mailto:") ? undefined : "me noreferrer"}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
            >
              <Icon name={link.icon} />
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <aside class="hero__aside reveal" style="--delay: 0.1s;">
      <figure class="hero__portrait">
        <img
          src={profile.headshot}
          alt={`Portrait of ${profile.name}`}
          width="440"
          height="440"
          loading="eager"
          decoding="async"
        />
      </figure>

      <div>
        <dl class="metrics">
          {
            profile.metrics.map((metric) => (
              <div class="metrics__item">
                <dt class="metrics__label">{metric.label}</dt>
                <dd class="metrics__value">{metric.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="metrics__note">{profile.metricsNote}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  /* dl/dt/dd need their default margins cleared for the metrics row */
  .metrics dd,
  .metrics dt {
    margin: 0;
  }

  .metrics__item {
    display: flex;
    flex-direction: column-reverse;
  }
</style>
