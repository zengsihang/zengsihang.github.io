---
import { profile, siteMeta } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteMeta.description } = Astro.props;

const pageTitle = title ? `${title} | ${siteMeta.title}` : siteMeta.title;
const canonical = new URL(Astro.url.pathname, siteMeta.siteUrl).toString();
const socialImage = new URL("/social-card.png", siteMeta.siteUrl).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: siteMeta.siteUrl,
  image: new URL(profile.headshot, siteMeta.siteUrl).toString(),
  description: siteMeta.description,
  affiliation: { "@type": "Organization", name: "Harvard Medical School", url: "https://hms.harvard.edu/" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "University of Washington" },
    { "@type": "CollegeOrUniversity", name: "Tsinghua University" }
  ],
  sameAs: profile.links.map((link) => link.href)
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={siteMeta.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
