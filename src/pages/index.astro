---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  AUTHOR_SELF,
  awards,
  education,
  experience,
  news,
  profile,
  publicationKindLabels,
  publicationKindOrder,
  publications,
  siteMeta,
  talks
} from "@/data/site";

const sections = publicationKindOrder
  .map((kind) => ({
    kind,
    label: publicationKindLabels[kind],
    items: publications.filter((p) => p.kind === kind).sort((a, b) => b.year - a.year)
  }))
  .filter((section) => section.items.length > 0);

/** Only the newest news items show on the page. */
const RECENT_NEWS = 5;

const scholar = profile.links.find((link) => link.label === "Google Scholar");

function venueTail(pub: (typeof publications)[number]) {
  return `${pub.venueDetail ? `, ${pub.venueDetail}` : ""}, ${pub.year}. `;
}

function splitAuthor(author: string) {
  const equal = author.endsWith("*");
  const name = equal ? author.slice(0, -1) : author;
  return { name, equal, self: name === AUTHOR_SELF };
}
---

<BaseLayout>
  <header class="header">
    <div>
      <h1>{profile.name}</h1>
      <p>
        {profile.role}<br />
        <a href={profile.affiliationHref}>{profile.affiliation}</a><br />
        {profile.location}
      </p>
      <p>
        Email: {profile.email}<br />
        {
          profile.links.map((link, i) => (
            <>
              {i > 0 && " · "}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
      </p>
    </div>
    <img src={profile.headshot} alt={`Portrait of ${profile.name}`} width="140" height="140" />
  </header>

  <section id="news">
    <h2>News</h2>
    <ul class="dated">
      {
        news.slice(0, RECENT_NEWS).map((item) => (
          <li>
            <span class="date">{item.date}</span>
            <span set:html={item.text} />
          </li>
        ))
      }
    </ul>
  </section>

  <section id="about">
    <h2>About</h2>
    {profile.bio.map((paragraph) => <p set:html={paragraph} />)}
    <p><strong>Research interests:</strong> {profile.interests.join("; ")}.</p>
  </section>

  <section id="publications">
    <h2>Publications</h2>
    <p class="muted">
      <sup class="equal">*</sup> Equal contribution. Also on <a href={scholar?.href}>Google Scholar</a>.
    </p>
    {
      sections.map((section) => (
        <>
          <h3>{section.label}</h3>
          <ol class="pubs">
            {section.items.map((pub) => (
              <li>
                {pub.links[0] ? <a href={pub.links[0].href}>{pub.title}</a> : pub.title}{/[?!]$/.test(pub.title) ? "" : "."}{" "}
                {pub.authors.map((author, i) => {
                  const a = splitAuthor(author);
                  return (
                    <>{i > 0 && ", "}{a.self ? <strong>{a.name}</strong> : a.name}{a.equal && <sup class="equal">*</sup>}</>
                  );
                })}{pub.authors.at(-1) === "et al." ? " " : ". "}
                <em>{pub.venue}</em>{venueTail(pub)}
                {pub.distinction && <strong class="distinction">{pub.distinction}.</strong>}{" "}
                {pub.note && <span class="note">{pub.note}.</span>}
                {pub.links.slice(1).map((link) => <>[<a href={link.href}>{link.label}</a>]{" "}</>)}
              </li>
            ))}
          </ol>
        </>
      ))
    }
  </section>

  <section id="education">
    <h2>Education</h2>
    <ul class="entries">
      {
        education.map((item) => (
          <li>
            <div class="row">
              <span>
                <strong>{item.institution}</strong>, {item.location}
              </span>
              <span class="date">{item.period}</span>
            </div>
            <div>{item.degree}</div>
            {item.detail && <div class="muted" set:html={item.detail} />}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="experience">
    <h2>Research Experience</h2>
    <ul class="entries">
      {
        experience.map((item) => (
          <li>
            <div class="row">
              <span>
                <strong>{item.organization}</strong>, {item.title}
              </span>
              <span class="date">{item.period}</span>
            </div>
            <div class="muted">{item.description}</div>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="talks">
    <h2>Invited Talks</h2>
    <ul class="plain">
      {
        talks.map((talk) => (
          <li>
            {talk.title}. <em>{talk.venue}</em>, {talk.date}.
          </li>
        ))
      }
    </ul>
  </section>

  <section id="awards">
    <h2>Awards</h2>
    <ul class="dated">
      {
        awards.map((award) => (
          <li>
            <span class="date">{award.year}</span>
            <span>{award.title}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <footer>Last updated {siteMeta.lastUpdated}.</footer>
</BaseLayout>
