---
import Icon from "@/components/Icon.astro";
import PublicationEntry from "@/components/PublicationEntry.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  affiliations,
  awards,
  education,
  experience,
  profile,
  publicationKindLabels,
  publicationKindOrder,
  publications,
  skills
} from "@/data/site";
import type { PublicationKind } from "@/types";

const peerReviewed = publications.filter(
  (publication) => publication.kind === "journal" || publication.kind === "conference"
).length;

const grouped = publicationKindOrder
  .map((kind: PublicationKind) => ({
    kind,
    label: publicationKindLabels[kind],
    items: publications
      .filter((publication) => publication.kind === kind)
      .sort((a, b) => b.year - a.year)
  }))
  .filter((group) => group.items.length > 0 && group.kind !== "thesis");

const scholar = profile.socialLinks.find((link) => link.icon === "scholar");
---

<BaseLayout
  title="CV"
  description="Curriculum vitae of Sihang Zeng — postdoctoral research fellow in Biomedical Informatics at Harvard Medical School. Education, research positions, publications, awards, and affiliations."
>
  <section class="section page-head">
    <div class="shell">
      <div class="cv-masthead">
        <div>
          <h1 class="page-head__title">Sihang Zeng</h1>
          <p class="page-head__intro">
            {profile.role}, {profile.affiliation}
            <br />
            {profile.location} · <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </p>
        </div>

        <dl class="summary">
          <div>
            <dt>Peer-reviewed</dt>
            <dd>{peerReviewed}</dd>
          </div>
          {
            profile.metrics.map((metric) => (
              <div>
                <dt>{metric.label}</dt>
                <dd>{metric.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="page-head__actions no-print">
        <button class="btn btn--primary" type="button" data-print>
          <Icon name="download" />
          Download PDF
        </button>
        {
          scholar && (
            <a class="btn" href={scholar.href} target="_blank" rel="noreferrer">
              <Icon name="scholar" />
              Google Scholar
            </a>
          )
        }
        <a class="btn" href={`mailto:${profile.email}`}>
          <Icon name="email" />
          Email
        </a>
      </div>
      <p class="cv-note no-print">
        Citation counts from {profile.metricsNote}. “Download PDF” opens your browser’s print
        dialog — choose “Save as PDF”.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading title="Education" />
      <ol class="cv-list">
        {
          education.map((item) => (
            <li class="cv-entry">
              <p class="cv-entry__period">{item.period}</p>
              <div>
                <h3 class="cv-entry__title">{item.degree}</h3>
                <p class="cv-entry__org">{item.institution}</p>
                <ul class="cv-entry__details">
                  {item.details.map((detail) => (
                    <li set:html={detail} />
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading title="Research positions" />
      <ol class="cv-list">
        {
          experience.map((item) => (
            <li class="cv-entry">
              <p class="cv-entry__period">{item.period}</p>
              <div>
                <h3 class="cv-entry__title">{item.title}</h3>
                <p class="cv-entry__org">
                  {item.organizationHref ? (
                    <a href={item.organizationHref} target="_blank" rel="noreferrer">
                      {item.organization}
                    </a>
                  ) : (
                    item.organization
                  )}
                </p>
                <p class="cv-entry__note">{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading title="Awards and honors" />
      <ol class="cv-list">
        {
          awards.map((item) => (
            <li class="cv-entry">
              <p class="cv-entry__period">{item.year}</p>
              <div>
                <h3 class="cv-entry__title">{item.title}</h3>
                {item.detail && <p class="cv-entry__note">{item.detail}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading title="Publications">
        <a class="link-more no-print" href="/publications/">
          Annotated list
          <Icon name="arrow" />
        </a>
      </SectionHeading>
      {
        grouped.map((group) => (
          <div class="pub-group">
            <div class="pub-group__head">
              <h3 class="pub-group__title">{group.label}</h3>
              <span class="pub-group__count">{group.items.length}</span>
            </div>
            <ol class="pub-list">
              {group.items.map((publication) => (
                <PublicationEntry publication={publication} showSummary={false} />
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading title="Research areas and affiliations" />
      <div class="cv-columns">
        {
          [...skills, ...affiliations].map((group) => (
            <div>
              <h3 class="cv-column__label">{group.label}</h3>
              <ul class="cv-column__list">
                {group.items.map((entry) => (
                  <li>{entry}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document
    .querySelector<HTMLButtonElement>("[data-print]")
    ?.addEventListener("click", () => window.print());
</script>

<style>
  .cv-masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .page-head__intro a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-underline-offset: 0.16em;
  }

  .summary {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .summary > div {
    display: flex;
    flex-direction: column-reverse;
  }

  .summary dt,
  .summary dd {
    margin: 0;
  }

  .summary dt {
    color: var(--ink-3);
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  .summary dd {
    font-size: 1.0625rem;
    font-weight: 620;
    letter-spacing: -0.025em;
    font-variant-numeric: tabular-nums;
    line-height: 1.25;
  }

  .cv-note {
    margin-top: 0.625rem;
    color: var(--ink-4);
    font-size: var(--fs-xs);
  }
</style>
